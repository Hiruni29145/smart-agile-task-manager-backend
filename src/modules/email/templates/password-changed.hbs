{{#> main}}
<h1
    style="margin: 0 0 20px 0; font-family: sans-serif; font-size: 24px; line-height: 30px; color: #1a1a1a; font-weight: bold;">
    Password Changed</h1>



<p style="margin: 0 0 20px 0; font-family: sans-serif; font-size: 16px; line-height: 24px; color: #4a4a4a;">
    This is a confirmation that the password for your {{#if companyName}}{{companyName}}{{else}}Smart Agile System{{/if}}
    account was changed successfully.
</p>

<p style="margin: 0 0 20px 0; font-family: sans-serif; font-size: 16px; line-height: 24px; color: #4a4a4a;">
    If you did not make this change, please contact our support team immediately.
</p>

{{#if supportEmail}}
<!-- Button : BEGIN -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" style="margin: auto;">
    <tr>
        <td style="border-radius: 4px; background: #3b82f6; text-align: center;">
            <a href="mailto:{{supportEmail}}" target="_blank"
                style="background: #3b82f6; border: 1px solid #3b82f6; font-family: sans-serif; font-size: 16px; line-height: 1.1; text-align: center; text-decoration: none; display: block; border-radius: 4px; font-weight: bold;">
                <span style="display: block; padding: 12px 24px; color: #ffffff;">Contact Support</span>
            </a>
        </td>
    </tr>
</table>
<!-- Button : END -->
{{/if}}

<p style="margin: 20px 0 0 0; font-family: sans-serif; font-size: 16px; line-height: 24px; color: #4a4a4a;">
    Best regards,<br>The {{#if companyName}}{{companyName}}{{else}}Smart Agile System{{/if}} Team
</p>
{{/main}}